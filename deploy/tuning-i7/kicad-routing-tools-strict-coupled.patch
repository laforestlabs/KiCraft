+                raise ValueError("missing bounded USB terminal group")
+            if len({ep['ref'] for ep in declared}) != 1:
+                raise ValueError("USB alias joins must stay on one component")
+            pads = []
+            for ep in declared:
+                matches = [p for p in pcb.pads_by_net.get(nid, [])
+                           if p.component_ref == ep['ref'] and str(p.pad_number) == str(ep['pin'])]
+                if len(matches) != 1 or matches[0] in pads:
