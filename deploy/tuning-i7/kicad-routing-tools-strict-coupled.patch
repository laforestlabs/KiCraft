+"""Exercise bounded USB routing with the native engine and real synthetic pads."""
+import io
+import json
+import re
+from contextlib import redirect_stdout
+
+import pytest
+
+from test_strict_coupled import _board
+from route_diff import batch_route_diff_pairs
+from synth import make_pad, make_net, make_pcb
+from kicad_parser import BoardInfo
+
+
+def _policy(alias=False):
+    segment = {'id': 'connector_esd', 'positive_net': '/D_P', 'negative_net': '/D_N',
+               'positive_from': [{'ref': 'U1', 'pin': '1'}],
+               'negative_from': [{'ref': 'U1', 'pin': '2'}],
+               'positive_to': [{'ref': 'J1', 'pin': '1'}],
+               'negative_to': [{'ref': 'J1', 'pin': '2'}]}
+    bounds = []
+    if alias:
+        segment['positive_from'].append({'ref': 'U1', 'pin': '3'})
+        bounds.append({'segment_id': 'connector_esd', 'polarity': 'positive',
+                       'side': 'from', 'ref': 'U1', 'pins': ['1', '3'],
+                       'max_length_mm': 1.0, 'envelope_mm': [1.5, 1.2, 2.5, 2.2]})
+    return {'segment': segment, 'mode': 'bounded_uncontrolled', 'width_mm': .15,
+            'gap_mm': .15, 'max_length_mm': .9, 'contact_join_bounds': bounds}
+
+
+def _run(pcb, policy, *, strict=True, track_width=.3, clearance=.1, grid_step=.1):
+    out = io.StringIO()
+    with redirect_stdout(out):
+        result = batch_route_diff_pairs(
+            'synthetic', '', ['/D_*'], layers=['F.Cu', 'B.Cu'],
+            clearance=clearance, track_width=track_width, diff_pair_gap=policy.get('gap_mm', .15),
+            via_size=.5, via_drill=.3, grid_step=grid_step,
+            max_iterations=10000, return_results=True, pcb_data=pcb,
+            require_coupled=strict, usb_bounded_launch_policy=policy)
+    summaries = re.findall(r'JSON_SUMMARY: (\{.*\})', out.getvalue())
+    assert summaries, out.getvalue()
+    return result, json.loads(summaries[-1])
+
+
+def test_short_bounded_link_is_honestly_reported():
+    result, summary = _run(_board(), _policy())
+    assert result[0] == 1 and result[1] == 0
+    assert summary['strict_coupled'] and not summary['failed_diff_pairs']
+    assert not summary['routed_diff_pairs'] and summary['bounded_local_pairs']
+    assert not summary['member_incomplete_pairs']
+    assert not summary['single_ended_fallback']['attempted']
+    receipt, = summary['usb_bounded_launch_receipts']
+    assert receipt['main_geometry'] == 'local_uncontrolled'
+    assert {s['net'] for s in receipt['spans'] if s['kind'] == 'local_link'} == {'/D_P', '/D_N'}
+    assert all(s['length_mm'] <= 1.8 + 1e-6 for s in receipt['spans'])
+    assert all(seg['width_mm'] == .15 for s in receipt['spans'] for seg in s['segments'])
+
+
+def test_long_main_has_four_bounded_launches_and_full_width_middle():
+    policy = _policy()
+    policy['segment']['id'] = 'connector_mcu_series'
+    result, summary = _run(_board(span=8), policy)
+    assert result[0] == 1 and result[1] == 0
+    assert summary['routed_diff_pairs'] and not summary['member_incomplete_pairs']
+    receipt, = summary['usb_bounded_launch_receipts']
+    assert receipt['main_geometry'] == 'coupled'
+    launches = [span for span in receipt['spans'] if span['kind'] == 'terminal_launch']
+    assert {(s['net'], s['side']) for s in launches} == {
+        ('/D_P', 'src'), ('/D_P', 'tgt'), ('/D_N', 'src'), ('/D_N', 'tgt')}
+    assert all(s['length_mm'] <= policy['max_length_mm'] + 1e-6 for s in launches)
+    assert all(abs(row['width_mm'] - policy['width_mm']) < 1e-6
+               for span in launches for row in span['segments'])
+    for nid in (1, 2):
+        assert any(s.net_id == nid and abs(s.width - .3) < 1e-6
+                   for route in result[3]['results'] for s in route['new_segments'])
+
+
+def test_declared_same_component_alias_join():
+    pcb = _board()
+    pcb.pads_by_net[1].append(make_pad(1, 2, 1.5, ref='U1', num='3',
+                                       net_name='/D_P', size_x=.3, size_y=.3))
+    result, summary = _run(pcb, _policy(alias=True))
+    assert result[0] == 1 and result[1] == 0
+    receipt, = summary['usb_bounded_launch_receipts']
+    joins = [s for s in receipt['spans'] if s['kind'] == 'alias_join']
+    assert len(joins) == 1 and joins[0]['net'] == '/D_P'
+    assert joins[0]['length_mm'] <= 1.0 + 1e-6
+    assert not summary['member_incomplete_pairs']
+
+
+def test_bounded_policy_rejects_unapproved_width_and_nonstrict():
+    with pytest.raises(ValueError, match='strict coupled'):
+        _run(_board(), _policy(), strict=False)
+    with pytest.raises(ValueError, match='nonempty contract'):
+        _run(_board(), {})
+    policy = _policy()
+    policy['width_mm'] = .001
+    with pytest.raises(ValueError, match='invalid bounded USB launch geometry'):
+        _run(_board(), policy)
+
+
+def test_bounded_policy_rejects_undeclared_contact_join():
+    pcb = _board()
+    pcb.pads_by_net[1].append(make_pad(1, 2, 1.5, ref='U1', num='3',
+                                       net_name='/D_P', size_x=.3, size_y=.3))
+    policy = _policy(alias=True)
+    policy['contact_join_bounds'] = []
+    with pytest.raises(ValueError, match='contact-join bound'):
+        _run(pcb, policy)
+
