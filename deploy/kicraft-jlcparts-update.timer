[Unit]
Description=Daily refresh of the offline JLC parts catalog

[Timer]
# Daily: upstream (yaqwsx/jlcparts) publishes nightly, and stock freshness is
# load-bearing since the §9.26 gate hard-blocks on the dump's JLC stock — a
# weeks-old snapshot said millions for parts that were long dry (KC-4AZ7PE).
# Randomized delay avoids hammering GitHub Pages at a popular instant.
OnCalendar=*-*-* 04:00
RandomizedDelaySec=2h
Persistent=true

[Install]
WantedBy=timers.target
