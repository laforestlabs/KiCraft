[Unit]
Description=Weekly refresh of the offline JLC parts catalog

[Timer]
# Weekly is plenty: the dump is ~650 MB compressed and stock churn matters on
# the weeks scale, not days. Randomized delay avoids hammering GitHub Pages
# at a popular instant.
OnCalendar=Sun 04:00
RandomizedDelaySec=2h
Persistent=true

[Install]
WantedBy=timers.target
