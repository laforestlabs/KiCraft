# Copy this file to .env (which is gitignored) and fill in your key.
# NEVER commit .env or paste the key into chat/logs.

# Required: your OpenRouter API key (prepaid balance, auto top-up OFF).
OPENROUTER_API_KEY=sk-or-...

# Model is swappable; the spend caps below are independent of which you pick.
KICRAFT_MODEL=deepseek/deepseek-v4-flash

# Hard caps enforced in code (defense in depth behind the prepaid + card limits).
# The app self-stops at these even though the OpenRouter balance is higher.
KICRAFT_DAILY_USD_CEILING=5
KICRAFT_TOTAL_USD_CEILING=50
KICRAFT_MAX_TOKENS_PER_CALL=1024

# Global kill switch: set to 1 to refuse ALL model calls.
KICRAFT_KILL_SWITCH=

# OpenRouter provider routing + caching (cost safety). The same model id is served
# by several backends at very different prices, and only some cache the re-sent
# prefix. Without this, OpenRouter occasionally routes a call to a backend 40-60x
# pricier (and non-caching). Defaults prefer the DeepSeek backend (auto-caches the
# prefix at 0.25x) with a hard per-Mtok price ceiling that bounds any fallback.
# Prices are USD per million tokens; set a cap to 0 to disable that ceiling.
KICRAFT_PROVIDER_ORDER=deepseek
KICRAFT_PROVIDER_ALLOW_FALLBACKS=true
KICRAFT_MAX_PRICE_PROMPT=0.40
KICRAFT_MAX_PRICE_COMPLETION=1.50
KICRAFT_ENABLE_PROMPT_CACHE=true

# Web app (kicraft.server.web): per-user accounts + session secret.
# Signup is gated by an invite code you hand to alpha testers. KICRAFT_ACCESS_PASSWORD
# is a legacy fallback for the invite code when KICRAFT_SIGNUP_CODE is unset.
KICRAFT_SIGNUP_CODE=
KICRAFT_ACCESS_PASSWORD=
KICRAFT_STORAGE_SECRET=change-me-to-a-long-random-string
KICRAFT_WEB_HOST=0.0.0.0
KICRAFT_WEB_PORT=8080

# Stripe billing (credit-card checkout for the Pro/Max tiers). All four must be
# set for checkout to go live; otherwise /pricing shows the paid tiers as
# "coming soon" and the webhook refuses events. Use test-mode keys first; the
# price ids are the two recurring monthly Prices created in the Stripe
# dashboard, and the webhook secret comes from the dashboard's endpoint for
# https://<host>/billing/webhook.
KICRAFT_STRIPE_SECRET_KEY=
KICRAFT_STRIPE_WEBHOOK_SECRET=
KICRAFT_STRIPE_PRICE_PRO=
KICRAFT_STRIPE_PRICE_MAX=

# Optional path overrides (defaults under ~/.kicraft/).
# KICRAFT_SPEND_LEDGER=
# KICRAFT_USERS_DB=
# KICRAFT_PROJECTS_DIR=
# KICRAFT_WORK_DIR=

# Build queue / host protection. One `kicraft build` saturates ~6 cores during
# place+route, so concurrent builds are bounded host-wide by flock slots
# (default: cpu_count // 6, min 1; 0 disables). Extra builds queue FIFO and the
# UI shows the user their position. The optional standalone worker
# (deploy/kicraft-build-worker.service) runs queued builds in its own service so
# they survive web restarts; without it the web app runs them in-process.
# KICRAFT_BUILD_SLOTS=1
# KICRAFT_BUILD_SLOTS_DIR=

# Required for automated routing. KiCraft preflights this sole pinned router.
# See docs/kicad-routing-tools-experiment.md for provisioning and version pins.
# KICRAFT_KICAD_ROUTING_TOOLS_PATH=/opt/KiCadRoutingTools
# KICRAFT_KICAD_ROUTING_TOOLS_PYTHON=/opt/krt-venv/bin/python
