# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg

# Secrets and local config (never commit)
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Manual end-to-end KiCraft test runs (one dir per run)
/tests/manual-runs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# KiCad experiment artifacts (generated by pipeline)
.experiments/
# ...except the committed frozen-leaf parent-corpus fixture (scripts/replay_corpus.py).
!tests/fixtures/replay_workspace/*/.experiments/
!tests/fixtures/replay_workspace/*/.experiments/**

# KiCraft per-project session state (not portable; .kicraft/parts/ is
# intentionally not ignored so curated project-local parts ship with the repo).
.kicraft/state.json
.kicraft/session_id

# Default KiCraft synthesis output dir
/generated/

# NiceGUI per-session storage, written when the web app runs locally
.nicegui/

# Logs
logs/
*.log

# provider-bench live-run artifacts (timestamped JSON + PNG)
provider_bench_*.json
provider_bench_*.png

# Claude Code sandbox bind-mounts (sensitive paths masked as /dev/null
# at the project root). These aren't real project files; ignoring them
# keeps `git status` clean across sessions.
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.mcp.json
/.profile
/.ripgreprc
/.zprofile
/.zshrc
/.idea
/.vscode
/.claude/agents
/.claude/settings.json
/.claude/settings.local.json
.render-check/

# EasyEDA API response cache (generated by add-part / lookup)
.easyeda_cache/
